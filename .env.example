PORT=3000
NODE_ENV=development
# Database: Supabase Postgres when set, else local SQLite (dev/test only).
# Production REFUSES to boot without this (ephemeral disk would lose data).
# Use the pooled URI (port 6543) from Supabase Dashboard → Connect.
DATABASE_URL=
BUGSHIELD_DATA_DIR=./.var/data
PUBLIC_BASE_URL=http://localhost:3000
BOOTSTRAP_OWNER_EMAIL=owner@bugshield.local
BOOTSTRAP_OWNER_PASSWORD=change-me-12chars!!
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
GITHUB_TOKEN=
APP_SECRET_KEY=dev-secret-change-me-32bytes-minimum!!
